{
  "controller_type": "vhmd_hmd",
  "name": "vhmd integration test bindings (HMD)",
  "bindings": {
    "/actions/test": {
      "eyetracking": [
        {
          "output": "/actions/test/in/gaze",
          "path": "/user/head/eyetracking"
        }
      ],
      "sources": [
        {
          "path": "/user/head/proximity",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/test/in/proximity"
            }
          }
        }
      ]
    }
  }
}
