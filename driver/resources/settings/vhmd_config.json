{
  // VirtualHMD driver configuration. Comments are allowed.
  // Reloaded on every SteamVR start. See docs/protocol.md and README.md.
  "network": {
    "bind": "127.0.0.1",   // loopback only by default
    "port": 39570,
    "allowRemote": false   // must be true to bind anything other than 127.0.0.1
  },
  "updateRateHz": 120,
  "smoothing": 0.0,        // 0 = off, 0.5..0.9 = increasingly smooth (defined per 90 Hz tick)
  "timeout": {
    "ms": 500,
    "policy": "hold"       // hold | invalid | disconnect
  },
  "applyTrackerRoles": true, // write tracker roles to SteamVR's "trackers" settings unless the user set one
  // Base setup is 3-point (HMD + both controllers). Trackers are added to SteamVR
  // the first time a client sends to them ("pose" etc. or config op "add") and
  // default to timeoutPolicy "disconnect" so they grey out when the sender stops.
  // false = register every enabled tracker at startup (old behaviour).
  "trackersOnDemand": true,
  "log": { "errorsPerSecond": 5, "verbose": false },
  // HMD output. auto = "direct" on Linux (required by Linux SteamVR: the
  // compositor hands the eye images to the driver), "window" on Windows.
  // Virtual display. mode: "auto" (Linux: direct, Windows: window) | "window" | "direct".
  // refreshHz: frame rate, 1-240 (default 90). Lower = less work for SteamVR and the
  // apps (30 or 15 is plenty for automation / machine learning). Honoured exactly in
  // direct mode; change it while running with {"type":"config","op":"refresh_rate","hz":30}.
  // previewWindow: Windows direct mode, show the HMD image in a window at start.
  "display": { "mode": "auto", "refreshHz": 90, "previewWindow": false },
  // Direct mode only: latest eye images (both eyes side by side, RGBA8) in
  // shared memory for clients/python/examples/preview_viewer.py and your tools.
  "preview": {
    "enabled": true,
    "path": "/dev/shm/vhmd_preview",
    "fps": 15,
    "maxEyeWidth": 960,
    "vulkanDevice": -1,     // Vulkan physical device index; -1 = first (must be the GPU SteamVR uses)
    "autoStart": false      // false = capture only while a tool asks ({"op":"preview","mode":"on"}; preview_viewer.py does)
  },
  "vmt": {
    "enabled": false,      // accept VMT compatible OSC on the same port
    "indexMap": { }        // e.g. { "0": "tracker_0", "1": "left_hand" }
  },
  "hmd": {
    "enabled": true,       // false = trackers/controllers only (use alongside a real HMD)
    "serial": "VHMD-HMD-0",
    "pos": [0.0, 1.7, 0.0],
    "rot": [1.0, 0.0, 0.0, 0.0],
    "eyeTracking": true,
    "headModel": false     // true = "pos" is the neck pivot and SteamVR adds its neck model
  },
  "controllers": {
    "enabled": true,
    "skeleton": true,
    // Skeleton level of the controllers. partial = like hardware controllers (apps
    // such as VRChat use buttons); full = bone data passed through as sent (VRChat
    // then treats the hands as hand tracking). The hand twins are always full.
    "skeletonLevel": "partial",
    // Which device each hand starts as: "controllers" or "hands" (hand tracking).
    // Switch at runtime with {"type":"config","op":"hand_mode","mode":"hands"}.
    "handMode": "controllers",
    "left":  { "serial": "VHMD-CTL-L", "pos": [-0.2, 1.2, -0.3] },
    "right": { "serial": "VHMD-CTL-R", "pos": [ 0.2, 1.2, -0.3] }
  },
  "trackers": [
    { "id": "tracker_0", "role": "waist",       "serial": "VHMD-TRK-0", "pos": [ 0.00, 1.00,  0.00] },
    { "id": "tracker_1", "role": "left_foot",   "serial": "VHMD-TRK-1", "pos": [-0.12, 0.08,  0.00] },
    { "id": "tracker_2", "role": "right_foot",  "serial": "VHMD-TRK-2", "pos": [ 0.12, 0.08,  0.00] },
    { "id": "tracker_3", "role": "left_knee",   "serial": "VHMD-TRK-3", "pos": [-0.11, 0.50, -0.03] },
    { "id": "tracker_4", "role": "right_knee",  "serial": "VHMD-TRK-4", "pos": [ 0.11, 0.50, -0.03] },
    { "id": "tracker_5", "role": "left_elbow",  "serial": "VHMD-TRK-5", "pos": [-0.30, 1.15,  0.00] },
    { "id": "tracker_6", "role": "right_elbow", "serial": "VHMD-TRK-6", "pos": [ 0.30, 1.15,  0.00] },
    { "id": "tracker_7", "role": "chest",       "serial": "VHMD-TRK-7", "pos": [ 0.00, 1.35, -0.05] }
  ]
}
