{
  "jsonid": "input_profile",
  "controller_type": "vhmd_tracker",
  "device_class": "TrackedDeviceClass_GenericTracker",
  "resource_root": "vhmd",
  "driver_name": "vhmd",
  "input_bindingui_mode": "single_device",
  "input_source": {
    "/pose/raw": {
      "type": "pose",
      "binding_image_point": [ 100, 90 ]
    },
    "/input/system": { "type": "button", "click": true, "binding_image_point": [ 100, 40 ], "order": 1 },
    "/input/menu": { "type": "button", "click": true, "binding_image_point": [ 60, 60 ], "order": 2 },
    "/input/grip": { "type": "button", "click": true, "binding_image_point": [ 140, 60 ], "order": 3 },
    "/input/trigger": { "type": "trigger", "value": true, "click": true, "binding_image_point": [ 60, 120 ], "order": 4 },
    "/input/trackpad": { "type": "trackpad", "click": true, "touch": true, "binding_image_point": [ 140, 120 ], "order": 5 }
  },
  "default_bindings": []
}
